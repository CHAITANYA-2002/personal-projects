# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# MySQL — local MySQL80 service. Create the user with
# data/interim/create_user.sql (run as root in Workbench).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=slopewatch
MYSQL_USER=slopewatch
MYSQL_PASSWORD=change_me

# Open-Meteo daily call budget (free tier allows 10000)
OPENMETEO_DAILY_BUDGET=9000
OPENMETEO_BATCH_SIZE=8
OPENMETEO_SLEEP_SECONDS=0.4
