// Slopewatch — Power BI measures
//
// Paste each block into a new measure in Power BI Desktop.
// Model: connect to MySQL and import these tables —
//     mart_cell_daily_risk       (the map and the priority list)
//     mart_district_daily_risk   (the command-centre header)
//     mart_event_history         (the historical page)
//     mart_model_performance     (the model page)
//     dim_date                   (mark as the date table on full_date)
//     dim_cell                   (relationship to mart_cell_daily_risk on cell_id)
//
// Set MySQL host and database as M parameters named PgHost and PgDatabase in
// Power Query, not as literals. Moving from a local MySQL to a managed one
// later is then a parameter change rather than rebinding every query.


// ==========================================================================
// Command centre header
// ==========================================================================

Cells Critical =
CALCULATE (
    COUNTROWS ( mart_cell_daily_risk ),
    mart_cell_daily_risk[risk_band] = "critical"
)

Cells High =
CALCULATE (
    COUNTROWS ( mart_cell_daily_risk ),
    mart_cell_daily_risk[risk_band] IN { "high", "critical" }
)

Districts Affected =
CALCULATE (
    DISTINCTCOUNT ( mart_cell_daily_risk[district_name] ),
    mart_cell_daily_risk[risk_band] IN { "elevated", "high", "critical" }
)

// Exposure is only counted where risk is actually elevated. Summing population
// across every scored cell would report the population of the Himalaya, which
// is true and useless.
Population At Risk =
CALCULATE (
    SUM ( mart_cell_daily_risk[est_population] ),
    mart_cell_daily_risk[risk_band] IN { "high", "critical" }
)

Road Km At Risk =
CALCULATE (
    SUM ( mart_cell_daily_risk[road_km_total] ),
    mart_cell_daily_risk[risk_band] IN { "high", "critical" }
)

Settlements At Risk =
CALCULATE (
    SUM ( mart_cell_daily_risk[settlements] ),
    mart_cell_daily_risk[risk_band] IN { "high", "critical" }
)


// ==========================================================================
// Risk shape
// ==========================================================================

Max Probability = MAX ( mart_cell_daily_risk[probability] )

Mean Probability = AVERAGE ( mart_cell_daily_risk[probability] )

// Sum, not average. A district with one critical cell and forty quiet ones
// needs a team; its average would hide that entirely.
Total Priority = SUM ( mart_cell_daily_risk[priority_score] )

// Ordering for the band legend, so "critical" does not sort next to "elevated"
// alphabetically.
Band Rank =
SWITCH (
    SELECTEDVALUE ( mart_cell_daily_risk[risk_band] ),
    "critical", 5,
    "high", 4,
    "elevated", 3,
    "moderate", 2,
    "low", 1,
    0
)

Risk Colour =
SWITCH (
    SELECTEDVALUE ( mart_cell_daily_risk[risk_band] ),
    "critical", "#9C332B",
    "high", "#C4622D",
    "elevated", "#B4762A",
    "moderate", "#6E7B4F",
    "#2F6B57"
)


// ==========================================================================
// Movement over the forecast window
// ==========================================================================

Critical Cells Yesterday =
CALCULATE (
    [Cells Critical],
    DATEADD ( dim_date[full_date], -1, DAY )
)

Critical Change =
VAR Today = [Cells Critical]
VAR Yesterday = [Critical Cells Yesterday]
RETURN
    IF ( ISBLANK ( Yesterday ), BLANK (), Today - Yesterday )

Risk Trend 7d =
AVERAGEX (
    DATESINPERIOD ( dim_date[full_date], MAX ( dim_date[full_date] ), -7, DAY ),
    [Mean Probability]
)


// ==========================================================================
// Historical page
// ==========================================================================

Events = SUM ( mart_event_history[events] )

Deaths = SUM ( mart_event_history[deaths] )

Deaths Per Event =
DIVIDE ( [Deaths], [Events] )

Monsoon Share =
DIVIDE (
    SUM ( mart_event_history[monsoon_events] ),
    [Events]
)

Events Last Year =
SUM ( mart_event_history[events_same_month_last_year] )

Year Over Year =
VAR Current = [Events]
VAR Previous = [Events Last Year]
RETURN
    DIVIDE ( Current - Previous, Previous )


// ==========================================================================
// Model page
// ==========================================================================

// The headline metric. Accuracy is deliberately absent from this model: at the
// sampling ratio used, predicting "safe" everywhere scores 94%.
PR AUC =
CALCULATE (
    MAX ( mart_model_performance[pr_auc] ),
    mart_model_performance[eval_scope] = "test"
)

// The operational number. If a district inspects its top 5% of cells today,
// this is the share of real landslides it catches.
Recall At 5pct =
CALCULATE (
    MAX ( mart_model_performance[recall_at_5pct] ),
    mart_model_performance[eval_scope] = "test"
)

Brier Score =
CALCULATE (
    MAX ( mart_model_performance[brier] ),
    mart_model_performance[eval_scope] = "test"
)

// Held-out-region performance. Report this next to PR AUC, never instead of it:
// a large gap means the model knows where landslides happen rather than why.
Held Out PR AUC =
CALCULATE (
    AVERAGE ( mart_model_performance[pr_auc] ),
    CONTAINSSTRING ( mart_model_performance[eval_scope], "holdout:" )
)

Generalisation Gap =
VAR InSample = [PR AUC]
VAR HeldOut = [Held Out PR AUC]
RETURN
    IF ( ISBLANK ( HeldOut ), BLANK (), DIVIDE ( HeldOut, InSample ) )


// ==========================================================================
// Narrative
// ==========================================================================

Headline =
VAR Critical = [Cells Critical]
VAR People = [Population At Risk]
VAR Districts = [Districts Affected]
RETURN
    IF (
        Critical = 0,
        "No cells at critical risk in the selected window.",
        FORMAT ( Critical, "#,0" ) & " cells at critical risk across "
            & FORMAT ( Districts, "#,0" ) & " districts, with "
            & FORMAT ( People, "#,0" ) & " people in the exposed area."
    )

Model Caveat =
"Trained on " & FORMAT ( 1719, "#,0" ) &
" catalogued events, 2007-2016. Location accuracy is a median of 10 km, so " &
"predictions are cell-level and advisory. Not a substitute for an official " &
"warning from the state disaster authority."
